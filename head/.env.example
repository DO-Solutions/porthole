# Porthole head configuration. Copy to head/.env for docker compose; the values below work with the local
# fakes only. Production values live in the App Platform app as SECRET or GENERAL env vars, never in a file.

# Insights token for the head (insights:read, plus insights:update for write mode). The local fake accepts any value.
DIGITALOCEAN_TOKEN=dev-token-for-the-local-fake
# Shared key for every mutating route, 24 characters or more. Unset means mutating routes return 503.
PORTHOLE_CAPTAIN_KEY=dev-captain-key-local-only-0000
# Bearer the tentacles expect on their scenario endpoints (docker compose starts them with dev-key).
TENTACLE_KEY=dev-key
# The fleet description written by infra/fleet.py: ids, IPs, URNs, names, no secrets. Compose sets its own.
PORTHOLE_FLEET_JSON={}
# Bearer configured on the Insights webhook channel; /hooks/insights answers 401 without it.
PORTHOLE_HOOK_BEARER=dev-hook-bearer-local-only
# user:password configured on the webhook channel, instead of the bearer.
PORTHOLE_HOOK_BASIC=
# Signing secret configured on the channel; enables the signature checks on deliveries.
PORTHOLE_HOOK_SECRET=dev-hook-secret-local-only
# Public base URL, used in curl output and the webhook URL shown on the Alerts page.
PORTHOLE_PUBLIC_URL=http://localhost:8080
# 1 shows Pause and Resume on the Alerts page and enables the rule status route (needs insights:update).
PORTHOLE_INSIGHTS_WRITE=0
# Insights API base URL; docker compose points it at the fake.
PORTHOLE_INSIGHTS_BASE_URL=http://insights-fake:9000
# 1 reads the client address from the first X-Forwarded-For hop (App Platform); 0 locally.
PORTHOLE_TRUST_PROXY=0
# JSON object overriding control-panel link patterns once they are verified, e.g. {"insights.metrics": "https://..."}.
PORTHOLE_DEEPLINKS_JSON=
# Insights calls allowed per minute before panels serve cached data (the API allows 250).
PORTHOLE_UPSTREAM_BUDGET_PER_MIN=200
# Panel cache lifetime in seconds.
PORTHOLE_CACHE_TTL_S=20
# deckhand, harness-runtime or off.
PORTHOLE_BRAIN=deckhand
# Phase 2: Harness Runtime session name.
PORTHOLE_BRAIN_SESSION=
# Phase 2: token of the session owner, used to answer approvals.
PORTHOLE_BRAIN_TOKEN=
# Phase 2: the Action Gateway session's MCP URL.
PORTHOLE_GATEWAY_MCP_URL=
# Phase 2: API key the head's own MCP server requires from Action Gateway.
PORTHOLE_MCP_KEY=
# OTLP/HTTP base URL; unset means nothing is exported and spans stay in memory for the Traces page.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers for the OTLP exporters, k=v pairs separated by commas.
OTEL_EXPORTER_OTLP_HEADERS=
# service.name on spans and log records.
OTEL_SERVICE_NAME=porthole
# DEBUG, INFO, WARN or ERROR.
PORTHOLE_LOG_LEVEL=INFO
# Listen port when started with python -m porthole.main (the container always listens on 8080).
PORTHOLE_PORT=8080
# Version shown in /healthz; the Dockerfile bakes the git SHA when given as a build argument.
PORTHOLE_VERSION=
