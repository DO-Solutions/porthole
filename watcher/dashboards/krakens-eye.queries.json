{
  "dashboard": "krakens-eye",
  "description": "Every chart of the Kraken's Eye dashboard with its query, so the Dashboards page can run each one in Porthole. $tentacle is the dashboard variable (the tentacle names in the region), $region is the region shown.",
  "variables": [
    {"name": "tentacle", "type": "list", "from": "label values of resource_name on do.droplets.cpu_utilization",
     "regex": "kraken-tentacle-.*", "default": "all", "multi": true},
    {"name": "threshold", "type": "text", "default": "60", "constant": true}
  ],
  "charts": [
    {"title": "Tentacle CPU", "type": "time series", "group": "Tentacles", "legend": "{{resource_name}}",
     "promql": "avg by (resource_name) (do.droplets.cpu_utilization{resource_region_slug=\"$region\", resource_name=~\"$tentacle\"})",
     "thresholds": [{"mode": "absolute", "value": 40, "color": "gold"}, {"mode": "absolute", "value": 60, "color": "red"}]},
    {"title": "CPU now", "type": "stat", "group": "Tentacles", "legend": "{{resource_name}}",
     "promql": "max by (resource_name) (do.droplets.cpu_utilization{resource_region_slug=\"$region\", resource_name=~\"$tentacle\"})",
     "thresholds": [{"mode": "absolute", "value": 60, "color": "red"}]},
    {"title": "Memory used", "type": "gauge", "group": "Tentacles", "legend": "{{resource_name}}",
     "promql": "avg by (resource_name) (do.droplets.memory_utilization{resource_region_slug=\"$region\", resource_name=~\"$tentacle\"})",
     "thresholds": [{"mode": "percent", "value": 80, "color": "gold"}, {"mode": "percent", "value": 90, "color": "red"}]},
    {"title": "Load, 1 minute", "type": "bar", "group": "Tentacles", "legend": "{{resource_name}}",
     "promql": "max by (resource_name) (do.droplets.load_1{resource_region_slug=\"$region\", resource_name=~\"$tentacle\"})"},
    {"title": "Free disk", "type": "time series", "group": "Tentacles", "legend": "{{resource_name}} {{filesystem_mountpoint}}",
     "promql": "min by (resource_name, filesystem_mountpoint) (do.droplets.filesystem_free_bytes{resource_region_slug=\"$region\", resource_name=~\"$tentacle\"})"},
    {"title": "Private network out", "type": "pie", "group": "Tentacles", "legend": "{{resource_name}}",
     "promql": "sum by (resource_name) (do.droplets.network_transmit_bytes{resource_region_slug=\"$region\", resource_name=~\"$tentacle\", network_device=\"eth1\"})"},
    {"title": "Load balancer requests", "type": "time series", "group": "The sea", "legend": "{{resource_name}}",
     "promql": "sum by (resource_name) (do.load_balancers.requests_per_second{resource_region_slug=\"$region\", resource_name=\"kraken-lb\"})"},
    {"title": "Database connections", "type": "time series", "group": "The sea", "legend": "{{resource_name}}",
     "promql": "max by (resource_name) (do.databases.pg_connections{resource_region_slug=\"$region\", resource_name=\"kraken-pg\"})"},
    {"title": "Function invocations", "type": "bar", "group": "The sea", "legend": "{{resource_name}}",
     "promql": "sum by (resource_name) (do.serverless.invocations{resource_region_slug=\"$region\", resource_name=\"kraken\"})"},
    {"title": "Head requests", "type": "time series", "group": "The sea", "legend": "porthole",
     "promql": "sum by (resource_name) (do.apps.app_requests_per_second{resource_region_slug=\"$region\", resource_name=\"porthole\"})"},
    {"title": "Tentacle errors", "type": "log table", "group": "Logs and notes", "legend": "",
     "promql": null, "logs": {"service": "$tentacle", "severity": "ERROR", "max_entries": 500}},
    {"title": "How to read this", "type": "markdown", "group": "Logs and notes", "legend": "", "promql": null,
     "markdown": "Each tentacle keeps its color on every chart. Start a scenario on the Porthole Stir page and watch it here a minute later."}
  ]
}
