{
  "dashboard": "krakens-eye",
  "description": "Every chart of the Kraken's Eye dashboard with its query, so the Dashboards page can run each one in Porthole. $tentacle is the dashboard variable (the tentacle URNs in the region), $region is the region shown, and $load_balancer_urn, $database_urn and $head_urn are URNs from the fleet description. Fleet members are selected by resource_urn because fresh Droplets report no resource_name (B-023); the Function namespace has no URN in the fleet description and stays selected by name.",
  "variables": [
    {"name": "tentacle", "type": "list", "from": "label values of resource_urn on do.droplets.cpu_utilization",
     "regex": "do:droplet:.*", "default": "all", "multi": true},
    {"name": "threshold", "type": "text", "default": "60", "constant": true}
  ],
  "charts": [
    {"title": "Tentacle CPU", "type": "time series", "group": "Tentacles", "legend": "{{resource_urn}}",
     "promql": "avg by (resource_urn) (do.droplets.cpu_utilization{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\"})",
     "thresholds": [{"mode": "absolute", "value": 40, "color": "gold"}, {"mode": "absolute", "value": 60, "color": "red"}]},
    {"title": "CPU now", "type": "stat", "group": "Tentacles", "legend": "{{resource_urn}}",
     "promql": "max by (resource_urn) (do.droplets.cpu_utilization{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\"})",
     "thresholds": [{"mode": "absolute", "value": 60, "color": "red"}]},
    {"title": "Memory used", "type": "gauge", "group": "Tentacles", "legend": "{{resource_urn}}",
     "promql": "avg by (resource_urn) (do.droplets.memory_utilization{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\"})",
     "thresholds": [{"mode": "percent", "value": 80, "color": "gold"}, {"mode": "percent", "value": 90, "color": "red"}]},
    {"title": "Load, 1 minute", "type": "bar", "group": "Tentacles", "legend": "{{resource_urn}}",
     "promql": "max by (resource_urn) (do.droplets.load_1{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\"})"},
    {"title": "Free disk", "type": "time series", "group": "Tentacles", "legend": "{{resource_urn}} {{filesystem_mountpoint}}",
     "promql": "min by (resource_urn, filesystem_mountpoint) (do.droplets.filesystem_free_bytes{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\"})"},
    {"title": "Private network out", "type": "pie", "group": "Tentacles", "legend": "{{resource_urn}}",
     "promql": "sum by (resource_urn) (do.droplets.network_transmit_bytes{resource_region_slug=\"$region\", resource_urn=~\"$tentacle\", network_device=\"eth1\"})"},
    {"title": "Load balancer requests", "type": "time series", "group": "The sea", "legend": "{{resource_urn}}",
     "promql": "sum by (resource_urn) (do.load_balancers.requests_per_second{resource_region_slug=\"$region\", resource_urn=\"$load_balancer_urn\"})"},
    {"title": "Database connections", "type": "time series", "group": "The sea", "legend": "{{resource_urn}}",
     "promql": "max by (resource_urn) (do.databases.pg_connections{resource_region_slug=\"$region\", resource_urn=\"$database_urn\"})"},
    {"title": "Function invocations", "type": "bar", "group": "The sea", "legend": "{{resource_name}}",
     "promql": "sum by (resource_name) (do.serverless.invocations{resource_region_slug=\"$region\", resource_name=\"kraken\"})"},
    {"title": "Head requests", "type": "time series", "group": "The sea", "legend": "porthole",
     "promql": "sum by (resource_urn) (do.apps.app_requests_per_second{resource_region_slug=\"$region\", resource_urn=\"$head_urn\"})"},
    {"title": "Tentacle errors", "type": "log table", "group": "Logs and notes", "legend": "",
     "promql": null, "logs": {"service": "$tentacle", "severity": "ERROR", "max_entries": 500}},
    {"title": "How to read this", "type": "markdown", "group": "Logs and notes", "legend": "", "promql": null,
     "markdown": "Each tentacle keeps its color on every chart. Start a scenario on the Porthole Stir page and watch it here a minute later."}
  ]
}
