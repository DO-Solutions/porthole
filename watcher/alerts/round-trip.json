{
  "description": "Alert rule templates for the kraken fleet. infra/steps/insights.py replaces {{URN}} with the URN of the tentacle named in target and {{CHANNEL}} with the webhook channel id, then creates each rule with the status given. Only the round-trip rule is active; the others cover every operator and window and stay paused until a scenario needs them.",
  "rules": [
    {
      "purpose": "round-trip",
      "target": "kraken-tentacle-1",
      "status": "active",
      "used_by": "voyage alert-round-trip",
      "spec": {
        "name": "kraken churn",
        "query": {"metric": "do.droplets.cpu_utilization", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_1M"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_GREATER_THAN_OR_EQUAL", "warning": 40, "critical": 60},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}", "notify_on": ["SEVERITY_WARNING", "SEVERITY_CRITICAL"]}],
        "re_alert_duration": "RE_ALERT_DURATION_30M"
      }
    },
    {
      "purpose": "operator-gt-5m",
      "target": "kraken-tentacle-2",
      "status": "paused",
      "used_by": "scenario cpu with 2 workers",
      "spec": {
        "name": "kraken load above 1.5",
        "query": {"metric": "do.droplets.load_avg_1m", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_5M"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_GREATER_THAN", "warning": 0.9, "critical": 1.5},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}", "notify_on": ["SEVERITY_CRITICAL"]}],
        "re_alert_duration": "RE_ALERT_DURATION_1H"
      }
    },
    {
      "purpose": "operator-lte-10m",
      "target": "kraken-tentacle-1",
      "status": "paused",
      "used_by": "voyage ballast (memory 500 MB)",
      "spec": {
        "name": "kraken memory available at or below 250 MiB",
        "query": {"metric": "do.droplets.memory_available", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_10M"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_LESS_THAN_OR_EQUAL", "warning": 262144000, "critical": 157286400},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}"}],
        "re_alert_duration": "RE_ALERT_DURATION_4H"
      }
    },
    {
      "purpose": "operator-lt-15m",
      "target": "kraken-tentacle-2",
      "status": "paused",
      "used_by": "voyage ballast (disk 2048 MB)",
      "spec": {
        "name": "kraken free disk below 16 GiB",
        "query": {"metric": "do.droplets.filesystem_free", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_15M"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_LESS_THAN", "warning": 18253611008, "critical": 17179869184},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}"}],
        "re_alert_duration": "RE_ALERT_DURATION_NEVER"
      }
    },
    {
      "purpose": "operator-eq-30m",
      "target": "kraken-tentacle-3",
      "status": "paused",
      "used_by": "boundary operator check on an idle box",
      "spec": {
        "name": "kraken 15-minute load exactly zero",
        "query": {"metric": "do.droplets.load_avg_15m", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_30M"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_EQUAL", "critical": 0},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}"}],
        "re_alert_duration": "RE_ALERT_DURATION_4H"
      }
    },
    {
      "purpose": "operator-ne-1h",
      "target": "kraken-tentacle-3",
      "status": "paused",
      "used_by": "boundary operator check; fires whenever the box has any load",
      "spec": {
        "name": "kraken load not zero",
        "query": {"metric": "do.droplets.load_avg_1m", "resource_urns": ["{{URN}}"]},
        "condition": {"window": "EVALUATION_WINDOW_1H"},
        "thresholds": {"operator": "THRESHOLD_OPERATOR_NOT_EQUAL", "critical": 0},
        "notification_channels": [{"notification_channel_id": "{{CHANNEL}}"}],
        "re_alert_duration": "RE_ALERT_DURATION_NEVER"
      }
    }
  ]
}
